{
  "name": "@mandala-networks/construction-agent-skills",
  "version": "0.1.2",
  "description": "Portable construction evidence review and automation triage skills",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "benchmark": "bun run index.ts",
    "benchmark:example": "bun run index.ts benchmarks/bid-requirements-register/cases/case-001/candidate.example.json",
    "check": "bun run typecheck && bun run lint && bun test && bun run validate:package",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "validate:package": "bun run scripts/validate-package.ts",
    "export:workspace": "bun run scripts/export-workspace.ts",
    "smoke:platforms": "bun run scripts/smoke-platforms.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@types/bun": "latest",
    "typescript": "latest"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
